# Copy to .env (never commit it). Everything is optional for offline demos.

# Live models. Without a key the system runs the offline playbook models.
OPENAI_API_KEY=
SWITCHYARD_MODE=offline            # offline | live

# Where state lives (SQLite database, simulated apps, generated secrets).
SWITCHYARD_HOME=.switchyard

# Production: supply these from the secret store instead of the generated secrets.json.
SWITCHYARD_APPROVAL_SECRET=
SWITCHYARD_WEBHOOK_SECRET=
# principal:token pairs, comma separated (replace with SSO in production)
SWITCHYARD_APPROVER_TOKENS=

# Optional: a directory holding policy.toml / pricing.toml / estimator.toml overrides.
SWITCHYARD_CONFIG_DIR=
